# Copy this file to qa/.env and fill in real values.
# qa/.env is gitignored — never commit real credentials.
#
# Run the suite from inside the `website` directory:
#   node qa/client-journey-qa.js

# ── Preferred names ────────────────────────────────────────────────────────────
BASE_URL=https://royal-energy-alchemy.netlify.app
SUPABASE_URL=https://PROJECT.supabase.co
# REQUIRED: the Supabase service_role key (NOT the anon key).
# The suite seeds and deletes test rows and reads email_templates — RLS blocks
# the anon key, so it will NOT work here.
SUPABASE_SERVICE_ROLE_KEY=
REA_PIN=

# ── Legacy aliases (still accepted) ─────────────────────────────────────────────
QA_SITE_URL=
QA_SUPABASE_URL=
QA_SUPABASE_SERVICE_ROLE_KEY=
DASHBOARD_PIN=

# ── NOT sufficient ──────────────────────────────────────────────────────────────
# The anon key cannot run this suite. Provide the service_role key above instead.
# QA_SUPABASE_ANON=  (anon key — NOT accepted as a service role key)

# Optional: set to 1 to print full API response bodies on failure
QA_VERBOSE=0
